---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout title="Ethan Hassett">
  <div class="pb-(--space-3xl)">
    <p class="heading">Ethan Hassett</p>
    <div class="h-(--step-1)">
      <div class="inline-block text-(length:--step-1)">
        <span id="title"></span>
        <noscript><span id="title">Cloud Engineer</span></noscript>
      </div>
    </div>
    <hr class="divider" />
    <div
      class="flex flex-row flex-wrap justify-between gap-x-(--space-2xl) gap-y-(--space-xs)"
    >
      <a
        href="https://github.com/ehassett/"
        target="_blank"
        rel="noopener noreferrer"
      >
        &#8250; view my work
      </a>
      <a href="/contact"> &#8250; get in touch </a>
    </div>
  </div>
</Layout>

<script>
  const titles = [
    "Cloud Engineer",
    "Globetrotter",
    "Terraform Certified",
    "Home Chef",
    "Bedroom DJ",
  ];
  let reverse = false;
  let characterIndex = 0;
  let titleIndex = 0;
  let timeoutId: number | undefined;

  function typewriter() {
    const jitter = Math.floor(Math.random() * 25 + 45);
    const title = document.getElementById("title");

    if (title !== null) {
      const text = title.textContent ?? "";
      if (reverse) {
        if (text.length > 0) {
          title.textContent = text.slice(0, -1);
          timeoutId = window.setTimeout(typewriter, jitter);
        } else {
          titleIndex = (titleIndex + 1) % titles.length;
          reverse = false;
          timeoutId = window.setTimeout(typewriter, 1000);
        }
      } else {
        if (characterIndex === titles[titleIndex].length) {
          characterIndex = 0;
          reverse = true;
          timeoutId = window.setTimeout(typewriter, 3000);
        } else {
          if (characterIndex < titles[titleIndex].length) {
            title.textContent =
              text + titles[titleIndex].charAt(characterIndex);
            characterIndex++;
            timeoutId = window.setTimeout(typewriter, jitter);
          }
        }
      }
    }
  }

  function stopTypewriter() {
    window.clearTimeout(timeoutId);
    timeoutId = undefined;
  }

  function startTypewriter() {
    stopTypewriter();
    const title = document.getElementById("title");
    if (title === null) return;

    reverse = false;
    characterIndex = 0;
    titleIndex = 0;
    title.textContent = "";

    for (
      let shuffleIndex = titles.length - 1;
      shuffleIndex > 1;
      shuffleIndex--
    ) {
      const swapIndex = Math.floor(Math.random() * shuffleIndex) + 1;
      [titles[shuffleIndex], titles[swapIndex]] = [
        titles[swapIndex],
        titles[shuffleIndex],
      ];
    }

    typewriter();
  }

  document.addEventListener("astro:before-swap", stopTypewriter);
  document.addEventListener("astro:page-load", startTypewriter);
</script>
