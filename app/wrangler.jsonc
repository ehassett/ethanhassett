{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ethanhassett",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-05-07",
  "workers_dev": false,
  "preview_urls": true,
  "secrets": {
    "required": ["MAILGUN_API_KEY", "TURNSTILE_SECRET_KEY"],
  },
  "vars": {
    "MAILGUN_DOMAIN": "ethanhassett.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAABNLN_PugeImZoys",
  },
  "previews": {
    "vars": {
      "MAILGUN_DOMAIN": "ethanhassett.com",
      "TURNSTILE_SITE_KEY": "0x4AAAAAABNLEpdaRKmabBNe",
    },
  },
}
