{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ethanhassett-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-05-07",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": ["MAILGUN_API_KEY", "TURNSTILE_SECRET_KEY"],
  },
  "vars": {
    "MAILGUN_DOMAIN": "ethanhassett.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAABNK4577L8fCL9l5",
  },
  "env": {
    "staging": {
      "name": "ethanhassett-staging",
      "secrets": {
        "required": ["MAILGUN_API_KEY", "TURNSTILE_SECRET_KEY"],
      },
      "vars": {
        "MAILGUN_DOMAIN": "ethanhassett.com",
        "TURNSTILE_SITE_KEY": "0x4AAAAAABNLEpdaRKmabBNe",
      },
    },
    "production": {
      "name": "ethanhassett",
      "secrets": {
        "required": ["MAILGUN_API_KEY", "TURNSTILE_SECRET_KEY"],
      },
      "vars": {
        "MAILGUN_DOMAIN": "ethanhassett.com",
        "TURNSTILE_SITE_KEY": "0x4AAAAAABNLN_PugeImZoys",
      },
    },
  },
}
